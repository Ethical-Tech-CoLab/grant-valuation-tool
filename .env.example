# Anthropic API key — powers AI-assisted grant scoring.
# Get one at https://console.anthropic.com/ and copy this file to `.env.local`.
ANTHROPIC_API_KEY=sk-ant-...

# Tavily API key — powers "Import from the web" (scrapes a grant URL or search
# query so Claude can pre-fill the grant form). Get one at https://tavily.com/.
# Optional: without it, manual grant entry still works.
TAVILY_API_KEY=tvly-...

# Optional: override the scoring model (defaults to claude-opus-4-8).
# GRANT_SCORING_MODEL=claude-opus-4-8
